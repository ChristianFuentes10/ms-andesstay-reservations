# Copiar a .env (NO se sube a Git). Mismo User Pool de Cognito para todos los micros.
DB_USERNAME=postgres
DB_PASSWORD=postgres
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# true habilita POST /api/admin/demo/generar (datos de prueba para Grafana)
DEMO_ENABLED=true
