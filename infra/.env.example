# ==============================================================================
# VARIABLES DE ENTORNO — ms-andesstay-reservations (Entrega 3)
# ==============================================================================
# Copie este archivo a .env y configure los valores reales de su entorno.
# NUNCA guarde secretos reales en el repositorio ni suba el archivo .env a Git.
# ==============================================================================

# --- Servidor ---
SERVER_PORT=8082

# --- Base de Datos PostgreSQL (RDS en AWS o contenedor local) ---
DB_URL=jdbc:postgresql://localhost:5432/andesstay_reservations
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Microservicio de Catálogo (ms-andesstay-catalog) ---
CATALOG_SERVICE_URL=http://localhost:8081

# --- Cluster Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ADVERTISED_HOST=localhost

# --- Tópicos Kafka ---
REPORT_TOPIC=reporteria-eventos
REPORT_GROUP_ID=report-generator
REPORT_TOPIC_REPLICAS=1

# --- AWS Cognito (Resource Server JWT) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_CHANGE_ME
COGNITO_APP_CLIENT_ID=CHANGE_ME
DEFAULT_ROLE=HUESPED

# --- CORS (Frontend Angular) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Perfil y Generador Demo ---
DEMO_ENABLED=false
SPRING_PROFILES_ACTIVE=default

# --- Kafka-UI ---
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=changeme123

# --- Grafana y Datasources ---
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_DB_HOST=localhost:5432
GF_DB_NAME=andesstay_reservations
GF_DB_USER=postgres
GF_DB_PASSWORD=postgres
